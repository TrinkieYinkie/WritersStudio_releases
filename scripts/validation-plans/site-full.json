{
  "token": "writersstudio-site-full",
  "heartbeatMilliseconds": 5000,
  "steps": [
    {
      "name": "Validation lifecycle regressions",
      "command": "$NODE",
      "args": [
        "--test",
        "--test-concurrency=1",
        "scripts/run-bounded-validation.test.mjs"
      ],
      "timeoutMilliseconds": 60000
    },
    {
      "name": "Browser module syntax",
      "args": [
        "--check",
        "app.js"
      ],
      "timeoutMilliseconds": 15000,
      "command": "$NODE"
    },
    {
      "name": "Lifecycle scripts syntax",
      "args": [
        "--check",
        "scripts/serve-site.mjs"
      ],
      "timeoutMilliseconds": 15000,
      "command": "$NODE"
    },
    {
      "name": "Locale sync syntax",
      "args": [
        "--check",
        "scripts/sync-default-locale.mjs"
      ],
      "timeoutMilliseconds": 15000,
      "command": "$NODE"
    },
    {
      "name": "Static site contract",
      "args": [
        "scripts/validate-site.mjs"
      ],
      "timeoutMilliseconds": 30000,
      "command": "$NODE"
    },
    {
      "name": "Localization catalog",
      "args": [
        "scripts/validate-locales.mjs"
      ],
      "timeoutMilliseconds": 30000,
      "command": "$NODE"
    },
    {
      "name": "GitHub release parser fixtures",
      "args": [
        "scripts/test-release-parser.mjs"
      ],
      "timeoutMilliseconds": 30000,
      "command": "$NODE"
    },
    {
      "name": "Versioned legal page consistency",
      "command": "$NODE",
      "args": [
        "scripts/generate-legal-pages.mjs",
        "--check"
      ],
      "timeoutMilliseconds": 30000
    },
    {
      "name": "Statistics UI syntax",
      "command": "$NODE",
      "args": [
        "--check",
        "website-analytics-ui.js"
      ],
      "timeoutMilliseconds": 15000
    },
    {
      "name": "Aggregate statistics regressions",
      "command": "$NODE",
      "args": [
        "--test",
        "--test-concurrency=1",
        "scripts/website-analytics.test.mjs",
        "scripts/website-analytics-ui.test.mjs"
      ],
      "timeoutMilliseconds": 30000
    }
  ],
  "workingDirectory": "../.."
}
